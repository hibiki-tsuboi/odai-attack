{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "odaiattack-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-28",
	"observability": {
		"enabled": true
	},
	"vars": {
		// 通すモデル（カンマ区切り）。アプリの WordJudge.model を上げたら、ここにも足す
		"ALLOWED_MODELS": "jev-1.13.0"
	},
	// 回数の制限は Cloudflare のデータセンターごとに数える。namespace_id はアカウント内で重ならない整数にする
	"ratelimits": [
		{
			// アプリのインストールごと
			"name": "PER_INSTALL_LIMITER",
			"namespace_id": "71001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		},
		{
			// 全体（TypeSafe のアカウントの上限 1,200回/分に届かないように）
			"name": "GLOBAL_LIMITER",
			"namespace_id": "71002",
			"simple": {
				"limit": 1000,
				"period": 60
			}
		}
	]
}
